# Yandex Cloud Storage Configuration
# Copy this file to .env and fill in your credentials

# Required: Your Yandex Cloud Storage bucket name
YC_BUCKET=your-bucket-name

# Required: Yandex Cloud access key ID
YC_ACCESS_KEY_ID=your-access-key-id

# Required: Yandex Cloud secret access key
YC_SECRET_ACCESS_KEY=your-secret-access-key

# Optional: Custom endpoint (defaults to Yandex Cloud)
YC_ENDPOINT=https://storage.yandexcloud.net

# Optional: Region (defaults to ru-central1)
YC_REGION=ru-central1

# Optional: Root path to upload from (defaults to current directory)
UPLOAD_ROOT=.

# Alternative: You can also use AWS variable names
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# S3_BUCKET=your-bucket-name
